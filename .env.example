# ─── Grundlagen ───────────────────────────────────────────────────────────────
# Öffentliche Adresse, so wie sie im Browser steht (ohne / am Ende).
PUBLIC_URL=https://trips.example.org
# Langer Zufallswert, z. B. `openssl rand -base64 32`. Signiert die Sitzungen und
# verschlüsselt die AirTrail-Keys – nach dem ersten Start nicht mehr ändern.
SESSION_KEY=
# Port innen = außen (im Compose-Beispiel schon gesetzt).
# PORT=41873
# Nur hinter einem Reverse Proxy (NPM): X-Forwarded-* vertrauen.
TRUSTED_PROXY=true

# ─── Login über OIDC (Pocket ID) ──────────────────────────────────────────────
# Client in Pocket ID anlegen: Callback-URL = ${PUBLIC_URL}/auth/callback,
# öffentlicher Client mit PKCE, Zugang über "Allowed User Groups".
OIDC_ISSUER=https://id.example.org
OIDC_CLIENT_ID=
# Leer lassen bei einem öffentlichen Client (PKCE).
OIDC_CLIENT_SECRET=
# Mitglieder dieser Gruppe sind Admins (Mail-Log, JSON-Import, alle Reisen ändern).
OIDC_ADMIN_GROUP=admins
# Name des Anbieters auf dem Anmeldeknopf.
OIDC_PROVIDER_NAME=Kanonenwiese SSO
# OIDC_SCOPES=openid profile email groups
# Profilbilder nur von diesen Hosts (zusätzlich zum Issuer-Host), kommagetrennt.
# AVATAR_HOSTS=

# Nur für die Entwicklung: Anmeldung nur mit Namen. NIE IN PRODUKTION!
# DEV_LOGIN=true

# ─── Mail-Import (eigenes Postfach, z. B. trips@example.org) ──────────────────
IMAP_HOST=imap.example.org
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=trips@example.org
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Verarbeitete Mails hierhin verschieben (leer = nur als gelesen markieren).
# IMAP_DONE_MAILBOX=Verarbeitet
# Sicherheitsnetz-Abruf in Minuten; neue Mails kommen per IMAP IDLE sofort.
IMAP_POLL_MINUTES=5
# IMAP_IDLE=true
# Mails ablehnen, deren DMARC-Prüfung beim Mailserver fehlgeschlagen ist (gefälschter Absender).
MAIL_REQUIRE_DMARC_PASS=true
# Wird in den Einstellungen als Weiterleitungsadresse angezeigt.
IMPORT_ADDRESS=trips@example.org

# ─── Zusammenfassungs-Mails (optional) ────────────────────────────────────────
SMTP_HOST=smtp.example.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=trips@example.org
SMTP_PASSWORD=
SMTP_FROM=Trips <trips@example.org>

# ─── Auswertung mit Claude ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Karenz in Tagen, mit der eine Buchung einer bestehenden Reise zugeordnet wird.
TRIP_MATCH_DAYS=5

# ─── AirTrail (optional, braucht die API v1) ──────────────────────────────────
# Jeder hinterlegt seinen eigenen API-Key in den Einstellungen von Trips.
AIRTRAIL_URL=https://airtrail.example.org
